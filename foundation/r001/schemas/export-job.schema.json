{
  "$id": "https://spec-foundry.example/prontuario-simples/export-job.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachment_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]{2,63}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "clinic_id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "copy_request_id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "patient_id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "requested_by": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1"
    },
    "snapshot_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]{2,63}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "pending",
        "generating",
        "ready",
        "failed",
        "expired"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "clinic_id",
    "patient_id",
    "requested_by",
    "copy_request_id",
    "status",
    "snapshot_ids",
    "attachment_ids",
    "expires_at"
  ],
  "title": "Export job snapshot v0.1",
  "type": "object"
}
