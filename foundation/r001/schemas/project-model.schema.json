{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^r[0-9]{3,}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "readiness": {
      "type": "string",
      "enum": [
        "discovery",
        "ready_for_review",
        "approved_baseline"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "minItems": 0
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 0
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 0
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      },
      "minItems": 0
    },
    "eval_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eval_case"
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 0
    },
    "semantic_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_review"
      },
      "minItems": 0
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "project_name",
    "revision",
    "scope",
    "language",
    "readiness",
    "sources",
    "evidence",
    "claims",
    "requirements",
    "decisions",
    "tasks",
    "risks",
    "questions",
    "conflicts",
    "eval_cases",
    "artifacts",
    "semantic_reviews",
    "approvals"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-foundry.example/skill/v1/project-model.schema.json",
  "title": "Spec Foundry Skill ProjectModel 1.0",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "user_message",
            "pdf",
            "image",
            "web",
            "mcp"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "ref",
        "local_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVD-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "text_lines",
                "pdf_page",
                "image_region",
                "user_message",
                "web_section",
                "mcp_record"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        },
        "quality": {
          "type": "string",
          "enum": [
            "clear",
            "uncertain"
          ]
        }
      },
      "required": [
        "id",
        "source_ref",
        "quote",
        "locator",
        "quality"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CLM-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "user_definition",
            "supported_inference",
            "proposal"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "normal"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "deferred"
          ]
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "statement",
        "priority",
        "status",
        "claim_refs",
        "decision_refs"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEC-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved",
            "rejected"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "statement",
        "rationale",
        "status",
        "revision",
        "scope",
        "requirement_refs",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "discovery",
            "poc",
            "implementation"
          ]
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "requirement_refs",
        "dependency_refs",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RSK-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "normal"
          ]
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "description",
        "severity",
        "requirement_refs",
        "mitigation"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "deferred"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "text",
        "blocking",
        "status",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CON-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "blocking": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution_evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "description",
        "claim_refs",
        "blocking",
        "status",
        "resolution_evidence_ref"
      ],
      "additionalProperties": false
    },
    "eval_case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVAL-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "layer": {
          "type": "string",
          "enum": [
            "generator",
            "package",
            "target_system"
          ]
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "oracle": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "deterministic",
                "human",
                "runtime",
                "llm_judge"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "additionalProperties": false
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "normal"
          ]
        },
        "fixture_status": {
          "type": "string",
          "enum": [
            "missing",
            "synthetic",
            "curated"
          ]
        },
        "fixture_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "executor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "not_run",
            "blocked",
            "passed",
            "failed"
          ]
        },
        "report_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "layer",
        "requirement_refs",
        "scenario",
        "input",
        "expected",
        "oracle",
        "severity",
        "fixture_status",
        "fixture_ref",
        "executor",
        "execution_status",
        "report_ref"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "eval_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "path",
        "requirement_refs",
        "eval_refs"
      ],
      "additionalProperties": false
    },
    "semantic_review": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "llm"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs_changes"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "revision",
        "scope",
        "reviewer",
        "kind",
        "result",
        "notes",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "revision",
        "scope",
        "actor",
        "decision",
        "evidence_ref"
      ],
      "additionalProperties": false
    }
  }
}
