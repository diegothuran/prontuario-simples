{
  "$id": "https://spec-foundry.example/prontuario-simples/patient.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "birth_date": {
      "format": "date",
      "type": "string"
    },
    "clinic_id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "full_name": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "local_number": {
      "minLength": 1,
      "type": "string"
    },
    "preferred_name": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "0.1"
    },
    "status": {
      "enum": [
        "active",
        "inactive"
      ],
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "id",
    "clinic_id",
    "local_number",
    "full_name",
    "birth_date",
    "preferred_name",
    "version",
    "status"
  ],
  "title": "Patient snapshot v0.1",
  "type": "object"
}
