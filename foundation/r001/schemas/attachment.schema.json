{
  "$id": "https://spec-foundry.example/prontuario-simples/attachment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "clean"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "scan_engine_version": {
            "minLength": 1,
            "type": "string"
          },
          "scanned_at": {
            "format": "date-time",
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "clinic_id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "encounter_id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "media_type": {
      "enum": [
        "application/pdf",
        "image/jpeg",
        "image/png"
      ],
      "type": "string"
    },
    "patient_id": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "scan_engine_version": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "scanned_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "0.1"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "quarantined",
        "clean",
        "rejected",
        "scan_failed"
      ],
      "type": "string"
    },
    "storage_key": {
      "pattern": "^private/[a-f0-9]{2}/[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "clinic_id",
    "patient_id",
    "encounter_id",
    "storage_key",
    "media_type",
    "bytes",
    "sha256",
    "status",
    "scan_engine_version",
    "scanned_at"
  ],
  "title": "Attachment snapshot v0.1",
  "type": "object"
}
